# ==========================================================
# Charria Ceramics · public_html
# ==========================================================
Options -Indexes
DirectoryIndex index.html
# Página propia para direcciones que no existen (la API sigue respondiendo en JSON)
ErrorDocument 404 /404.html

# Nada que empiece por punto (.env, .git, .htaccess...) es accesible
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\. - [F,L]
  # Carpeta interna del backend
  RewriteRule ^backend(/|$) - [F,L]
  # Salidas de herramientas de IA (Repomix, Graphify), por si se suben sin querer
  RewriteRule ^(graphify-out(/|$)|repomix-output\.|repomix\.config\.json$) - [F,L]
  # Forzar HTTPS (necesario para pagos)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Web en obras: las páginas de la raíz enseñan en-obras.html mientras NO exista
  # backend/storage/web-abierta (lo crea o lo borra el interruptor de Inicio del panel).
  # Sin instalar tampoco existe, así que una web recién subida sale «en obras».
  # /admin, /api, /assets y /uploads no se tocan. La cookie charria_vista=web la pone
  # el panel («Ver la web») para que tú puedas ver la web real mientras tanto.
  # La carpeta se saca de la ruta del fichero pedido para no depender de DOCUMENT_ROOT.
  RewriteCond %{REQUEST_FILENAME} ^(.*/)[^/]*$
  RewriteCond %1backend/storage/web-abierta !-f
  RewriteCond %{HTTP_COOKIE} !(^|;\s*)charria_vista=web(;|$)
  RewriteCond %{REQUEST_URI} !^/(en-obras|404)\.html$
  RewriteRule ^([^/]+\.html)?$ en-obras.html [L]
</IfModule>

# Configuración, código suelto y copias de seguridad (zip, tar, .bak, .old, ~...) nunca se sirven
<FilesMatch "(?i)(^\.|~$|\.(env|sql|log|md|lock|sh|ini|bak|old|orig|save|swp|tmp|dist|zip|tar|gz|tgz|7z|rar|sqlite|db|dump|yml|yaml|py|ps1|bat)$|composer\.(json|lock)$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # El navegador recuerda durante un año que esta web solo va por HTTPS
  Header always set Strict-Transport-Security "max-age=31536000"
  # Sin cámara, micrófono ni ubicación; sin plugins; nadie puede cambiar la base de los enlaces
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
  Header always set Content-Security-Policy "object-src 'none'; base-uri 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
  # No contar qué versión de PHP usa el servidor
  Header always unset X-Powered-By
  Header unset X-Powered-By
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
