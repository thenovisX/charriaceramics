# ==========================================================
# Charria Ceramics · variables de entorno
# Copia este fichero como ".env" y rellénalo. NUNCA lo subas a GitHub.
# Ubicación recomendada en Hostinger: UNA CARPETA POR ENCIMA de public_html
#   /home/uXXXXXXX/domains/tudominio.com/.env
# (también vale backend/.env, que está protegido por backend/.htaccess)
# ==========================================================

# --- Aplicación ---
APP_URL=https://charriaceramics.com
APP_TIMEZONE=Europe/Madrid
APP_DEBUG=false
# Otras webs tuyas que vayan a usar esta API (separadas por comas). Vacío = solo la propia web.
CORS_ALLOWED_ORIGINS=

# Token de un solo uso para /admin/setup.html (mínimo 16 caracteres).
# Bórralo en cuanto hayas creado tu usuario.
SETUP_TOKEN=

# Horas que dura la sesión del panel antes de pedir login otra vez
SESSION_TTL_HOURS=12

# --- MySQL (hPanel → Bases de datos → MySQL) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=u000000000_charria
DB_USER=u000000000_charria
DB_PASS=

# --- Stripe (dashboard.stripe.com → Desarrolladores) ---
# Empieza con las claves de prueba (sk_test_...) y cambia a sk_live_ al abrir la tienda
STRIPE_SECRET_KEY=
# Desarrolladores → Webhooks → endpoint https://tudominio.com/api/webhooks/stripe → "Signing secret"
STRIPE_WEBHOOK_SECRET=
CURRENCY=eur
# Minutos que se reservan stock y plazas mientras el cliente paga (mínimo 30)
CHECKOUT_HOLD_MINUTES=30

# --- Envíos ---
# Recogida gratis en el estudio
SHIPPING_PICKUP=true
# Tarifa plana si Packlink no está configurado o no responde (céntimos: 690 = 6,90 €)
SHIPPING_FLAT_CENTS=690
SHIPPING_FLAT_NAME=Envío estándar 48/72 h
# Envío gratis a partir de este importe en céntimos (0 = nunca)
SHIPPING_FREE_FROM_CENTS=0
# Caja por defecto (cm) y peso del embalaje (g)
SHIPPING_BOX_CM=30x30x30
SHIPPING_PACKAGING_GRAMS=600

# --- Packlink PRO (pro.packlink.es → Configuración → API key) ---
PACKLINK_API_KEY=
PACKLINK_API_URL=https://api.packlink.com/v1
# Suplemento que se suma a la tarifa de Packlink (céntimos), p. ej. por embalaje
SHIPPING_MARKUP_CENTS=0
SHIPPING_MAX_OPTIONS=4
PACKLINK_CONTENT=Cerámica artesanal
# Remitente (el estudio)
PACKLINK_SENDER_NAME=Charria
PACKLINK_SENDER_SURNAME=Ceramics
PACKLINK_SENDER_COMPANY=Charria Ceramics
PACKLINK_SENDER_STREET=Calle del Barro 12
PACKLINK_SENDER_ZIP=28001
PACKLINK_SENDER_CITY=Madrid
PACKLINK_SENDER_COUNTRY=ES
PACKLINK_SENDER_PHONE=
PACKLINK_SENDER_EMAIL=

# --- Emails (un buzón del propio dominio creado en hPanel → Emails) ---
MAIL_FROM=hola@charriaceramics.com
MAIL_ADMIN=hola@charriaceramics.com
MAIL_DISABLED=false

# --- Imágenes ---
UPLOAD_MAX_MB=10
UPLOADS_URL=/uploads
